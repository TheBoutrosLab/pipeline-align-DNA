// Public aligner-version contract for consumers such as metapipeline-DNA.
params {
    aligner_versions = [
        'BWA-MEM2': 'BWA-MEM2-2.3',
        'minibwa': 'minibwa-0.7',
        'HISAT2': 'HISAT2-2.2.1'
    ]

    // Backward-compatible parameter names used internally by align-DNA.
    aligner_version_params = [
        'BWA-MEM2': 'bwa_version',
        'minibwa': 'minibwa_version',
        'HISAT2': 'hisat2_version'
    ]
}
