import nextflow.util.SysHelper

// Default inputs/parameters of the pipeline
params {

    max_cpus   = SysHelper.getAvailCpus()
    max_memory = SysHelper.getAvailMemory()

    min_cpus   = 1
    min_memory = 1.MB

    ucla_cds = true

    // Set to false in sample-specific config file to not mark duplicates
    mark_duplicates = true

    gatk_command_mem_diff = 5.GB

    // tools and their versions
    bwa_version = "BWA-MEM2-2.3"
    minibwa_version = "minibwa-0.4"
    hisat2_version = "HISAT2-2.2.1"

    docker_container_registry_uclahscds = "ghcr.io/uclahs-cds"
    docker_container_registry_theboutroslab = "ghcr.io/theboutroslab"
    pipeval_version = "5.2.0"
    bwa_and_samtools_version = "2.3_samtools-1.17"
    minibwa_and_samtools_version = "0.4_samtools-1.24"
    hisat2_and_samtools_version = "2.2.1_samtools-1.17"
    picardtools_version = "3.4.0"
    samtools_version = "1.24"


    docker_image_bwa_and_samtools = "${-> params.docker_container_registry_uclahscds}/bwa-mem2:${params.bwa_and_samtools_version}"
    docker_image_minibwa_and_samtools = "${-> params.docker_container_registry_theboutroslab}/minibwa:${params.minibwa_and_samtools_version}"
    docker_image_hisat2_and_samtools = "${-> params.docker_container_registry_uclahscds}/hisat2:${params.hisat2_and_samtools_version}"
    docker_image_picardtools = "${-> params.docker_container_registry_theboutroslab}/picard:${params.picardtools_version}"
    docker_image_validate = "${-> params.docker_container_registry_uclahscds}/pipeval:${params.pipeval_version}"
    docker_image_gatk = "broadinstitute/gatk:4.6.2.0"
    docker_image_samtools = "${-> params.docker_container_registry_theboutroslab}/samtools:${params.samtools_version}"

    ucla_cds_analyte = "DNA"
    }

// Process specific scope
process {
    // Process results are stored to local cache.
    // If pipeline is launched with the 'resume' option, existing cache results will be used when available
    // rather than re-executing processes
    cache = true

    // Forward process 'stdout' to shell terminal and, consequently, the log file
    echo = true
    executor = 'local'

    // Other directives or options that should apply for every process

    // total amount of resources avaible to the pipeline
    cpus = params.max_cpus
    memory = params.max_memory
}

profiles {
    standard {
        apptainer {
            enabled = false
        }

        singularity {
            enabled = false
        }

        docker {
            enabled = true
            uid_and_gid = "-u \$(id -u):\$(id -g)"
            all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
            runOptions = "${uid_and_gid} ${all_group_ids}"
        }

        params.container_mount_flag = "-v"
    }

    // Define copy of default standard profile as docker to allow explicit docker selection
    // Profile aliasing isn't directly available so profile is copied
    docker {
        apptainer {
            enabled = false
        }

        singularity {
            enabled = false
        }

        docker {
            enabled = true
            uid_and_gid = "-u \$(id -u):\$(id -g)"
            all_group_ids = "\$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
            runOptions = "${uid_and_gid} ${all_group_ids}"
        }

        params.container_mount_flag = "-v"
    }

    apptainer {
        docker {
            enabled = false
        }

        singularity {
            enabled = false
        }

        apptainer {
            enabled = true

            autoMounts = true
            ociAutoPull = true
        }

        params.container_mount_flag = "-B"
    }

    singularity {
        docker {
            enabled = false
        }

        apptainer {
            enabled = false
        }

        singularity {
            enabled = true

            autoMounts = true
            ociAutoPull = true
        }

        params.container_mount_flag = "-B"
    }
}
